# ============ SERVIDOR ============
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ============ BASE DE DATOS ============
# auto | mysql | sqlite
# "auto" usa MySQL si MYSQL_HOST está definido; si no, SQLite (sin Docker).
DB_DIALECT=auto
DB_SQLITE_FILE=storage/keny.db

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=keny_user
MYSQL_PASSWORD=keny_pass_2026
MYSQL_DATABASE=keny_credits

# Analítica opcional (PostgreSQL)
PG_ENABLED=false
PG_HOST=localhost
PG_PORT=5432
PG_USER=keny_pg
PG_PASSWORD=keny_pg_pass
PG_DATABASE=keny_analytics
PG_SSL=false

# ============ JWT ============
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_diferente
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ============ SMTP (Gmail u otro) ============
# Si se deja vacío, los correos se guardan en storage/emails (modo simulado).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Créditos Pollos Keny <no-reply@polloskeny.com>"

# ============ BINANCE ============
BINANCE_ENABLED=true
BINANCE_API_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ============ URLS / CORS ============
APP_URL=http://localhost:3000
FRONT_URL=http://localhost:5173
CORS_ORIGINS=*

# ============ ALMACENAMIENTO ============
STORAGE_DIR=storage
